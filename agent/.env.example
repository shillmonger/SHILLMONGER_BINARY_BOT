# SHILLMONGER Windows Agent — copy to .env and fill in. NEVER commit .env.

# Stable identifier for this machine (lowercase slug, e.g. win-home-01).
AGENT_ID=win-home-01

# Reported in STATUS/heartbeat payloads.
AGENT_VERSION=0.1.0

# VPS sidecar tunnel endpoint (Phase C). ws(s):// or http(s):// — the tunnel
# client upgrades to WSS. Required only when AGENT_TUNNEL_ENABLED=true.
# AGENT_VPS_URL=http://bot-host-04.obsdnhost.com:25590

# Pre-shared HMAC secret for tunnel auth (Phase C). Generate a NEW value —
# never reuse BROKER_SIDECAR_SECRET or WORKER_HMAC_SECRET.
# AGENT_SHARED_SECRET=

# Local health endpoint — LOOPBACK ONLY. The service refuses to bind any
# non-loopback address.
AGENT_LOCAL_HEALTH_HOST=127.0.0.1
AGENT_LOCAL_HEALTH_PORT=8791

# Optional extra auth for local endpoints (X-Agent-Token header). The
# loopback bind is the primary control; set this for defense in depth.
# AGENT_LOCAL_TOKEN=

# Heartbeat cadence (seconds) — Phase B records beats locally; Phase C
# sends them over the tunnel.
AGENT_HEARTBEAT_SECONDS=15

# Reconnect backoff for infrastructure retries (Phase C tunnel client).
AGENT_RECONNECT_BASE_DELAY=1
AGENT_RECONNECT_MAX_DELAY=60

# Writable directory for agent state (Phase C session cache). Created if
# missing; diagnostics verify it stays writable.
# AGENT_STATE_DIR=./state

# Phase C feature flag — tunnel to the VPS sidecar. Keep false until the
# tunnel layer is deployed and approved.
AGENT_TUNNEL_ENABLED=false
