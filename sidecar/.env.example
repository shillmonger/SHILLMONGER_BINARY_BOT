# Broker sidecar secrets — copy to .env and fill in.
# NEVER commit the real .env.

# Shared secret between the Next.js app and this sidecar.
# Must match BROKER_SIDECAR_SECRET in the app's .env.local.
BROKER_SIDECAR_SECRET=change-me-to-a-long-random-string

# Bind address — keep localhost-only; this is an internal service.
BROKER_SIDECAR_HOST=127.0.0.1
BROKER_SIDECAR_PORT=8790

# ---------------------------------------------------------------- Telegram
# API_ID / API_HASH / PHONE_NUMBER are read from BINARY_TRADING_BOTS/.env
# (the parent package env) — same Telegram app as SHILLMONGER_BOT, but this
# service uses its OWN session. Uncomment here only to override.
#
# API_ID=34123895
# API_HASH=
# PHONE_NUMBER=

# REQUIRED: a NEW StringSession generated by `python tools/telegram_login.py`.
# Never reuse SHILLMONGER_BOT's session string.
TELEGRAM_SESSION_STRING=

# Connect automatically when the sidecar starts (default off).
TELEGRAM_AUTO_START=false

# Allow interactive phone/code/2FA login prompts (terminal only — leave
# false for normal server operation).
ALLOW_INTERACTIVE_LOGIN=false

# ---------------------------------------------------------------- Listener
# Phase 3: Telegram message listener. Raw events are forwarded to the
# Next.js internal ingest endpoint — no parsing, no trading.
#
# BINARY_INGEST_URL — full URL of the app's ingest route, e.g.
#   http://127.0.0.1:3000/api/internal/binary-telegram/ingest
BINARY_INGEST_URL=
# HMAC secret shared with the Next.js app (same value as WORKER_HMAC_SECRET
# in the app's .env.local).
WORKER_HMAC_SECRET=
# Start the message listener automatically on sidecar startup (default off).
TELEGRAM_LISTENER_AUTO_START=false
# Per-request timeout for event forwarding, seconds (default 10).
# LISTENER_FORWARD_TIMEOUT=10
